# ─────────────────────────────────────────────────────────
# WC 2026 Predictions — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────

# Supabase — get from https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Only used server-side (API routes). Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# BallDontLie — free API key from https://www.balldontlie.io
BALLDONTLIE_API_KEY=your_balldontlie_key_here

# App URL — used for auth redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
